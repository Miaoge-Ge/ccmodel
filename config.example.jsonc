{
  // ── ccmodel config ──────────────────────────────────────────────────────
  // The WHOLE config is just a list of models. Each one shows up in Claude
  // Code's /model menu. A model entry is, in the common case, just three fields:
  //
  //     { "model": "<id>", "url": "<base url>", "key": "<api key>" }
  //
  // Everything else is inferred:
  //   • id    →  claude-<slug(model)>   (Claude Code only keeps claude/anthropic ids)
  //   • type  →  from `url`             ("…/anthropic" = passthrough, else OpenAI-compatible)
  //   • auth  →  `key` wrapped as `Authorization: Bearer <key>`
  //
  // 1M CONTEXT: add a `[1m]` suffix to the model id. With it, that model runs at
  // a guaranteed 1,000,000-token window; without it, the standard 200K. That's
  // the only switch — one entry = one /model pick.
  //   "model": "MiniMax-M3"       → standard 200K pick
  //   "model": "MiniMax-M3[1m]"   → 1M pick (the suffix is stripped before it
  //                                  reaches the backend; only add it to models
  //                                  that really support 1M)
  //
  // Copy this file to config.jsonc and edit THAT (config.jsonc is gitignored, so
  // your keys never get committed). JSONC: // and /* */ comments + trailing
  // commas are fine. Keys starting with "_" are ignored (handy for notes).
  // ────────────────────────────────────────────────────────────────────────

  // Optional globals — the defaults are right for almost everyone:
  // "host": "127.0.0.1",   // bind address
  // "port": 8141,          // listen port
  // "max_tokens": 64000,   // the max_tokens floor forced onto every request
  // "force_1m": false,     // force 1M on EVERY request (only if all backends support it)

  "models": [
    // 1) Real Claude — no url/key; uses your existing Claude Code login. Opus 4.8
    //    supports 1M, so the `[1m]` suffix gives a guaranteed-1M pick.
    { "model": "claude-opus-4-8[1m]", "name": "Claude Opus 4.8 (1M)" },

    // 2) DeepSeek — native Anthropic endpoint. A "…/anthropic" url is detected as
    //    a passthrough, so tools + streaming + the model's thinking blocks all
    //    work as-is. `key` is auto-wrapped as `Authorization: Bearer <key>`.
    {
      "model": "deepseek-v4-pro",
      "url": "https://api.deepseek.com/anthropic",
      "key": "${DEEPSEEK_API_KEY}",
    },

    // 3) MiniMax-M3 — OpenAI-compatible (a "…/v1" url is detected as openai). The
    //    proxy translates Anthropic⇄OpenAI (tools both ways). M3 is natively ~1M,
    //    so the `[1m]` suffix advertises it as 1M. `body` passes provider params;
    //    reasoning_split keeps <think> out of the answer.
    {
      "model": "MiniMax-M3[1m]",
      "url": "https://api.minimax.io/v1",
      "key": "${MINIMAX_API_KEY}",
      "max_output_tokens": 64000,
      "body": { "reasoning_split": true },
    },

    // 4) GPT-5.5 via a ChatGPT/Codex login (no API key). Run `codex login` once.
    //    `api` is required because there's no url to infer the kind from.
    { "model": "gpt-5.5", "api": "codex" },

    // 5) A local OpenAI-compatible server (Ollama / llama.cpp / LM Studio). No key
    //    needed, and not 1M — so no `[1m]` suffix.
    { "model": "your-local-model", "url": "http://127.0.0.1:11434/v1" },
  ],
}
