{
  // ── ccmodel config ──────────────────────────────────────────────────────
  // The whole config is just a list of models. Each one shows up in Claude
  // Code's /model menu. Only `name` is required — everything else is inferred:
  //   • id    →  claude-<slug(name)>           (so Claude Code keeps it)
  //   • type  →  from the url ("/anthropic" = passthrough, else OpenAI-compatible)
  //   • auth  →  key wrapped as `Authorization: Bearer <key>`
  //   • [1m]  →  a "<name>[1m]" 1M-context variant is added automatically
  //
  // Copy this file to config.jsonc and edit that (config.jsonc is gitignored, so
  // your keys never get committed). JSONC: // comments + trailing commas are OK.
  // ────────────────────────────────────────────────────────────────────────

  // Optional globals (defaults are fine for almost everyone):
  // "port": 8141,

  "models": [
    // Real Claude — no url/key needed, uses your existing login. The [1m] pick
    // gives you a guaranteed 1,000,000-token context window.
    { "name": "Claude Opus 4.8", "model": "claude-opus-4-8" },

    // DeepSeek — native Anthropic endpoint (".../anthropic" → passthrough, so
    // tools + streaming + the model's thinking blocks all work as-is).
    {
      "name": "DeepSeek V4 Pro",
      "url": "https://api.deepseek.com/anthropic",
      "key": "${DEEPSEEK_API_KEY}",
      "model": "deepseek-v4-pro"
    },

    // MiniMax-M3 — OpenAI-compatible (".../v1" → openai_compat). `body` passes
    // provider-specific params; reasoning_split keeps <think> out of the answer.
    {
      "name": "MiniMax M3",
      "url": "https://api.minimax.io/v1",
      "key": "${MINIMAX_API_KEY}",
      "model": "MiniMax-M3",
      "body": { "reasoning_split": true }
    },

    // GPT-5.5 via a ChatGPT/Codex login (no API key). Run `codex login` once.
    { "name": "GPT-5.5", "api": "codex", "model": "gpt-5.5" },

    // A local OpenAI-compatible server (Ollama / llama.cpp / LM Studio).
    { "name": "Local", "url": "http://127.0.0.1:11434/v1", "model": "your-local-model" }
  ]
}
