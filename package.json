{
  "name": "ccmodel",
  "version": "1.2.0",
  "description": "Run Claude Code's UltraCode mode — and a reliable [1m] 1M-context — on any model you already pay for. A tiny loopback proxy for the /model picker.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ccmodel": "bin/ccmodel.mjs",
    "ccmodel-proxy": "dist/src/main.js",
    "ccmodel-doctor": "dist/scripts/doctor.js"
  },
  "files": [
    "dist/src",
    "dist/scripts",
    "bin/ccmodel.mjs",
    "scripts/install-icons.mjs",
    "scripts/uninstall.mjs",
    "config.example.jsonc",
    "docs/MANUAL.md",
    "docs/MANUAL.zh-CN.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "launch": "node bin/ccmodel.mjs",
    "proxy": "node dist/src/main.js",
    "icons": "node scripts/install-icons.mjs",
    "uninstall": "node scripts/uninstall.mjs",
    "doctor": "node dist/scripts/doctor.js",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "test:coverage": "npm run build && node --test --experimental-test-coverage \"dist/test/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "keywords": [
    "claude-code",
    "ultracode",
    "anthropic",
    "proxy",
    "1m-context",
    "openai-compatible",
    "llm-gateway"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
